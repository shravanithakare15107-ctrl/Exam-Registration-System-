import tkinter as tk
from tkinter import ttk, messagebox
import mysql.connector
from mysql.connector import Error


# =========================================================
# MYSQL CONFIGURATION
# =========================================================

DB_HOST = "localhost"
DB_USER = "root"
DB_PASSWORD = "YOUR_MYSQL_PASSWORD"
DB_NAME = "exam_registration_db"


# =========================================================
# DATABASE CONNECTION
# =========================================================

def connect_database():
    try:
        connection = mysql.connector.connect(
            host=DB_HOST,
            user=DB_USER,
            password=DB_PASSWORD,
            database=DB_NAME
        )
        return connection

    except Error as e:
        messagebox.showerror(
            "Database Error",
            f"Could not connect to MySQL.\n\n{e}"
        )
        return None


# =========================================================
# LOGIN WINDOW
# =========================================================

def login_window():

    login = tk.Tk()
    login.title("Exam Registration System - Login")
    login.geometry("450x350")
    login.resizable(False, False)

    title = tk.Label(
        login,
        text="EXAM REGISTRATION SYSTEM",
        font=("Arial", 18, "bold")
    )
    title.pack(pady=30)

    frame = tk.Frame(login)
    frame.pack(pady=10)

    tk.Label(
        frame,
        text="Username:",
        font=("Arial", 12)
    ).grid(row=0, column=0, padx=10, pady=10)

    username_entry = tk.Entry(
        frame,
        width=25,
        font=("Arial", 12)
    )
    username_entry.grid(row=0, column=1, padx=10, pady=10)

    tk.Label(
        frame,
        text="Password:",
        font=("Arial", 12)
    ).grid(row=1, column=0, padx=10, pady=10)

    password_entry = tk.Entry(
        frame,
        width=25,
        font=("Arial", 12),
        show="*"
    )
    password_entry.grid(row=1, column=1, padx=10, pady=10)

    def check_login():

        username = username_entry.get()
        password = password_entry.get()

        if username == "admin" and password == "admin123":
            login.destroy()
            main_window()

        else:
            messagebox.showerror(
                "Login Failed",
                "Invalid username or password."
            )

    tk.Button(
        login,
        text="LOGIN",
        width=15,
        font=("Arial", 12, "bold"),
        command=check_login
    ).pack(pady=20)

    tk.Label(
        login,
        text="Default Login: admin / admin123",
        font=("Arial", 9)
    ).pack()

    login.mainloop()


# =========================================================
# MAIN WINDOW
# =========================================================

def main_window():

    root = tk.Tk()
    root.title("Exam Registration System")
    root.geometry("1200x700")
    root.resizable(True, True)

    # -----------------------------------------------------
    # TITLE
    # -----------------------------------------------------

    title = tk.Label(
        root,
        text="EXAM REGISTRATION SYSTEM",
        font=("Arial", 22, "bold")
    )
    title.pack(pady=15)

    # -----------------------------------------------------
    # FORM FRAME
    # -----------------------------------------------------

    form_frame = tk.LabelFrame(
        root,
        text="Registration Details",
        font=("Arial", 12, "bold"),
        padx=10,
        pady=10
    )
    form_frame.pack(fill="x", padx=20, pady=10)

    # Variables
    registration_id = tk.StringVar()
    student_name = tk.StringVar()
    roll_no = tk.StringVar()
    branch = tk.StringVar()
    semester = tk.StringVar()
    exam_type = tk.StringVar()
    subject = tk.StringVar()
    exam_date = tk.StringVar()
    email = tk.StringVar()
    phone = tk.StringVar()

    # -----------------------------------------------------
    # FORM LABELS AND ENTRIES
    # -----------------------------------------------------

    tk.Label(
        form_frame,
        text="Registration ID"
    ).grid(row=0, column=0, padx=10, pady=8)

    id_entry = tk.Entry(
        form_frame,
        textvariable=registration_id,
        width=25
    )
    id_entry.grid(row=0, column=1, padx=10, pady=8)

    tk.Label(
        form_frame,
        text="Student Name"
    ).grid(row=0, column=2, padx=10, pady=8)

    name_entry = tk.Entry(
        form_frame,
        textvariable=student_name,
        width=25
    )
    name_entry.grid(row=0, column=3, padx=10, pady=8)

    tk.Label(
        form_frame,
        text="Roll Number"
    ).grid(row=1, column=0, padx=10, pady=8)

    roll_entry = tk.Entry(
        form_frame,
        textvariable=roll_no,
        width=25
    )
    roll_entry.grid(row=1, column=1, padx=10, pady=8)

    tk.Label(
        form_frame,
        text="Branch"
    ).grid(row=1, column=2, padx=10, pady=8)

    branch_combo = ttk.Combobox(
        form_frame,
        textvariable=branch,
        values=[
            "AI&DS",
            "CSE",
            "ENTC",
            "Mechanical",
            "Civil",
            "Electrical"
        ],
        width=22,
        state="readonly"
    )
    branch_combo.grid(row=1, column=3, padx=10, pady=8)

    tk.Label(
        form_frame,
        text="Semester"
    ).grid(row=2, column=0, padx=10, pady=8)

    semester_combo = ttk.Combobox(
        form_frame,
        textvariable=semester,
        values=[
            "1",
            "2",
            "3",
            "4",
            "5",
            "6",
            "7",
            "8"
        ],
        width=22,
        state="readonly"
    )
    semester_combo.grid(row=2, column=1, padx=10, pady=8)

    tk.Label(
        form_frame,
        text="Exam Type"
    ).grid(row=2, column=2, padx=10, pady=8)

    exam_combo = ttk.Combobox(
        form_frame,
        textvariable=exam_type,
        values=[
            "Regular",
            "Backlog",
            "ATKT",
            "Supplementary"
        ],
        width=22,
        state="readonly"
    )
    exam_combo.grid(row=2, column=3, padx=10, pady=8)

    tk.Label(
        form_frame,
        text="Subject"
    ).grid(row=3, column=0, padx=10, pady=8)

    subject_entry = tk.Entry(
        form_frame,
        textvariable=subject,
        width=25
    )
    subject_entry.grid(row=3, column=1, padx=10, pady=8)

    tk.Label(
        form_frame,
        text="Exam Date"
    ).grid(row=3, column=2, padx=10, pady=8)

    date_entry = tk.Entry(
        form_frame,
        textvariable=exam_date,
        width=25
    )
    date_entry.grid(row=3, column=3, padx=10, pady=8)

    tk.Label(
        form_frame,
        text="Email"
    ).grid(row=4, column=0, padx=10, pady=8)

    email_entry = tk.Entry(
        form_frame,
        textvariable=email,
        width=25
    )
    email_entry.grid(row=4, column=1, padx=10, pady=8)

    tk.Label(
        form_frame,
        text="Phone Number"
    ).grid(row=4, column=2, padx=10, pady=8)

    phone_entry = tk.Entry(
        form_frame,
        textvariable=phone,
        width=25
    )
    phone_entry.grid(row=4, column=3, padx=10, pady=8)

    # -----------------------------------------------------
    # CLEAR FORM
    # -----------------------------------------------------

    def clear_form():

        registration_id.set("")
        student_name.set("")
        roll_no.set("")
        branch.set("")
        semester.set("")
        exam_type.set("")
        subject.set("")
        exam_date.set("")
        email.set("")
        phone.set("")

        id_entry.config(state="normal")

    # -----------------------------------------------------
    # VALIDATION
    # -----------------------------------------------------

    def validate():

        if (
            registration_id.get() == "" or
            student_name.get() == "" or
            roll_no.get() == "" or
            branch.get() == "" or
            semester.get() == "" or
            exam_type.get() == "" or
            subject.get() == "" or
            exam_date.get() == "" or
            email.get() == "" or
            phone.get() == ""
        ):
            messagebox.showwarning(
                "Validation",
                "Please fill all fields."
            )
            return False

        if not phone.get().isdigit() or len(phone.get()) != 10:
            messagebox.showwarning(
                "Validation",
                "Phone number must contain exactly 10 digits."
            )
            return False

        if "@" not in email.get():
            messagebox.showwarning(
                "Validation",
                "Enter a valid email address."
            )
            return False

        return True

    # -----------------------------------------------------
    # ADD REGISTRATION
    # -----------------------------------------------------

    def add_registration():

        if not validate():
            return

        connection = connect_database()

        if connection is None:
            return

        try:

            cursor = connection.cursor()

            query = """
            INSERT INTO registrations
            (
                registration_id,
                student_name,
                roll_no,
                branch,
                semester,
                exam_type,
                subject,
                exam_date,
                email,
                phone
            )
            VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)
            """

            values = (
                registration_id.get(),
                student_name.get(),
                roll_no.get(),
                branch.get(),
                semester.get(),
                exam_type.get(),
                subject.get(),
                exam_date.get(),
                email.get(),
                phone.get()
            )

            cursor.execute(query, values)
            connection.commit()

            messagebox.showinfo(
                "Success",
                "Registration added successfully."
            )

            cursor.close()
            connection.close()

            clear_form()
            view_registrations()

        except Error as e:

            messagebox.showerror(
                "Error",
                str(e)
            )

            connection.close()

    # -----------------------------------------------------
    # VIEW REGISTRATIONS
    # -----------------------------------------------------

    def view_registrations():

        for item in table.get_children():
            table.delete(item)

        connection = connect_database()

        if connection is None:
            return

        try:

            cursor = connection.cursor()

            cursor.execute(
                "SELECT * FROM registrations"
            )

            rows = cursor.fetchall()

            for row in rows:
                table.insert("", tk.END, values=row)

            cursor.close()
            connection.close()

        except Error as e:

            messagebox.showerror(
                "Error",
                str(e)
            )

    # -----------------------------------------------------
    # SEARCH REGISTRATION
    # -----------------------------------------------------

    def search_registration():

        search_value = registration_id.get()

        if search_value == "":
            messagebox.showwarning(
                "Search",
                "Enter Registration ID."
            )
            return

        connection = connect_database()

        if connection is None:
            return

        try:

            cursor = connection.cursor()

            query = """
            SELECT * FROM registrations
            WHERE registration_id = %s
            """

            cursor.execute(
                query,
                (search_value,)
            )

            row = cursor.fetchone()

            if row:

                student_name.set(row[1])
                roll_no.set(row[2])
                branch.set(row[3])
                semester.set(row[4])
                exam_type.set(row[5])
                subject.set(row[6])
                exam_date.set(row[7])
                email.set(row[8])
                phone.set(row[9])

            else:

                messagebox.showinfo(
                    "Search",
                    "Registration not found."
                )

            cursor.close()
            connection.close()

        except Error as e:

            messagebox.showerror(
                "Error",
                str(e)
            )

    # -----------------------------------------------------
    # UPDATE REGISTRATION
    # -----------------------------------------------------

    def update_registration():

        if not validate():
            return

        connection = connect_database()

        if connection is None:
            return

        try:

            cursor = connection.cursor()

            query = """
            UPDATE registrations
            SET
                student_name=%s,
                roll_no=%s,
                branch=%s,
                semester=%s,
                exam_type=%s,
                subject=%s,
                exam_date=%s,
                email=%s,
                phone=%s
            WHERE registration_id=%s
            """

            values = (
                student_name.get(),
                roll_no.get(),
                branch.get(),
                semester.get(),
                exam_type.get(),
                subject.get(),
                exam_date.get(),
                email.get(),
                phone.get(),
                registration_id.get()
            )

            cursor.execute(query, values)
            connection.commit()

            if cursor.rowcount > 0:

                messagebox.showinfo(
                    "Success",
                    "Registration updated successfully."
                )

            else:

                messagebox.showinfo(
                    "Update",
                    "Registration ID not found."
                )

            cursor.close()
            connection.close()

            view_registrations()

        except Error as e:

            messagebox.showerror(
                "Error",
                str(e)
            )

    # -----------------------------------------------------
    # DELETE REGISTRATION
    # -----------------------------------------------------

    def delete_registration():

        reg_id = registration_id.get()

        if reg_id == "":
            messagebox.showwarning(
                "Delete",
                "Enter Registration ID."
            )
            return

        answer = messagebox.askyesno(
            "Confirm Delete",
            "Are you sure you want to delete this registration?"
        )

        if not answer:
            return

        connection = connect_database()

        if connection is None:
            return

        try:

            cursor = connection.cursor()

            query = """
            DELETE FROM registrations
            WHERE registration_id=%s
            """

            cursor.execute(
                query,
                (reg_id,)
            )

            connection.commit()

            if cursor.rowcount > 0:

                messagebox.showinfo(
                    "Success",
                    "Registration deleted successfully."
                )

            else:

                messagebox.showinfo(
                    "Delete",
                    "Registration ID not found."
                )

            cursor.close()
            connection.close()

            clear_form()
            view_registrations()

        except Error as e:

            messagebox.showerror(
                "Error",
                str(e)
            )

    # -----------------------------------------------------
    # BUTTON FRAME
    # -----------------------------------------------------

    button_frame = tk.Frame(root)
    button_frame.pack(pady=10)

    tk.Button(
        button_frame,
        text="ADD",
        width=12,
        command=add_registration
    ).grid(row=0, column=0, padx=5)

    tk.Button(
        button_frame,
        text="VIEW",
        width=12,
        command=view_registrations
    ).grid(row=0, column=1, padx=5)

    tk.Button(
        button_frame,
        text="SEARCH",
        width=12,
        command=search_registration
    ).grid(row=0, column=2, padx=5)

    tk.Button(
        button_frame,
        text="UPDATE",
        width=12,
        command=update_registration
    ).grid(row=0, column=3, padx=5)

    tk.Button(
        button_frame,
        text="DELETE",
        width=12,
        command=delete_registration
    ).grid(row=0, column=4, padx=5)

    tk.Button(
        button_frame,
        text="CLEAR",
        width=12,
        command=clear_form
    ).grid(row=0, column=5, padx=5)

    def logout():

        answer = messagebox.askyesno(
            "Logout",
            "Do you want to logout?"
        )

        if answer:
            root.destroy()
            login_window()

    tk.Button(
        button_frame,
        text="LOGOUT",
        width=12,
        command=logout
    ).grid(row=0, column=6, padx=5)

    # -----------------------------------------------------
    # TABLE
    # -----------------------------------------------------

    table_frame = tk.Frame(root)
    table_frame.pack(fill="both", expand=True, padx=20, pady=10)

    columns = (
        "registration_id",
        "student_name",
        "roll_no",
        "branch",
        "semester",
        "exam_type",
        "subject",
        "exam_date",
        "email",
        "phone"
    )

    table = ttk.Treeview(
        table_frame,
        columns=columns,
        show="headings"
    )

    headings = [
        "Registration ID",
        "Student Name",
        "Roll No",
        "Branch",
        "Semester",
        "Exam Type",
        "Subject",
        "Exam Date",
        "Email",
        "Phone"
    ]

    for column, heading in zip(columns, headings):

        table.heading(
            column,
            text=heading
        )

        table.column(
            column,
            width=120
        )

    scrollbar_y = ttk.Scrollbar(
        table_frame,
        orient="vertical",
        command=table.yview
    )

    scrollbar_x = ttk.Scrollbar(
        table_frame,
        orient="horizontal",
        command=table.xview
    )

    table.configure(
        yscrollcommand=scrollbar_y.set,
        xscrollcommand=scrollbar_x.set
    )

    table.pack(
        side="left",
        fill="both",
        expand=True
    )

    scrollbar_y.pack(
        side="right",
        fill="y"
    )

    scrollbar_x.pack(
        side="bottom",
        fill="x"
    )

    # -----------------------------------------------------
    # SELECT ROW FROM TABLE
    # -----------------------------------------------------

    def select_row(event):

        selected = table.focus()

        if not selected:
            return

        values = table.item(
            selected,
            "values"
        )

        if values:

            registration_id.set(values[0])
            student_name.set(values[1])
            roll_no.set(values[2])
            branch.set(values[3])
            semester.set(values[4])
            exam_type.set(values[5])
            subject.set(values[6])
            exam_date.set(values[7])
            email.set(values[8])
            phone.set(values[9])

    table.bind(
        "<ButtonRelease-1>",
        select_row
    )

    # Load records when application starts
    view_registrations()

    root.mainloop()


# =========================================================
# START APPLICATION
# =========================================================

if __name__ == "__main__":
    login_window()
